# ========================================
# HRMS Frontend - Environment Configuration
# ========================================
# Copy values into .env / hosting env. Do not commit secrets.

# ========================================
# Production API URL (Required for Production)
# ========================================
# For local development, DO NOT set this (Vite proxies /api → localhost:5001)
VITE_API_URL=https://your-api.example.com

# Company ID used by public careers / jobs pages
VITE_PUBLIC_COMPANY_ID=your_company_mongodb_id_here

# ========================================
# Production Frontend URL (Optional)
# ========================================
# VITE_FRONTEND_URL=https://hrms.yourdomain.com

# ========================================
# Google OAuth Configuration
# ========================================
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# ========================================
# Feature Flags (Optional)
# ========================================
# VITE_ENABLE_AI_ANALYSIS=true
# VITE_ENABLE_NOTIFICATIONS=true

# ========================================
# How It Works:
# ========================================
# DEVELOPMENT (npm run dev):
#   - Frontend: http://localhost:5173
#   - API calls: /api → proxied to http://localhost:5001 (via vite.config.js)
#   - Set VITE_PUBLIC_COMPANY_ID for /careers
#
# PRODUCTION (npm run build):
#   - Set VITE_API_URL to the live backend
#   - Set VITE_PUBLIC_COMPANY_ID for public careers
